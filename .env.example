# LLM endpoint (OpenAI-compatible). MVP uses LongCat.
LLM_BASE_URL=https://api.longcat.chat/openai/v1
LLM_API_KEY=
LLM_MODEL=LongCat-2.0-Preview

# Fallback LLM providers (optional, comma-separated; same index across
# the three vars). Triggered when the primary returns 429 / 5xx / network
# errors. Currently configured: ByteDance 豆包 (Ark) on Volcengine.
# Add more by extending each var with another comma-separated entry.
LLM_FALLBACK_BASE_URLS=https://ark.cn-beijing.volces.com/api/v3
LLM_FALLBACK_API_KEYS=
LLM_FALLBACK_MODELS=doubao-lite-32k

# Upstash Redis (for cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Invite codes (comma-separated). Single-use codes gate access during MVP.
ALLOWED_INVITE_CODES=founder,friend1,friend2