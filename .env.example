# LLM endpoint (OpenAI-compatible). MVP uses LongCat.
LLM_BASE_URL=https://api.longcat.chat/openai/v1
LLM_API_KEY=
LLM_MODEL=LongCat-2.0-Preview

# Upstash Redis (for cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Invite codes (comma-separated). Single-use codes gate access during MVP.
ALLOWED_INVITE_CODES=founder,friend1,friend2